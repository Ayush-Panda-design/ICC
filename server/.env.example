# Mongo
MONGO_URI=mongodb://localhost:27017/interview-command-center
PORT=5000

# production | development
NODE_ENV=development

# Gate the whole ICC API. Leave empty to disable auth.
ICC_ACCESS_PASSWORD=

# Optional: comma-separated CORS origins (defaults: local Vite ports, or reflect Origin in production)
# CORS_ORIGINS=https://your-app.onrender.com

# Optional LiveHub URL overrides
# LIVEHUB_INTERNSHALA_URL=https://internshala.com/internships/software-development-internship
# LIVEHUB_WELLFOUND_URL=https://wellfound.com/role/r/software-engineer-intern
# LIVEHUB_UNSTOP_URL=https://unstop.com/internships
# LIVEHUB_LINKEDIN_URL=https://www.linkedin.com/jobs/search/?keywords=software%20engineer%20intern&location=India&f_E=1
# LIVEHUB_REMOTIVE_URL=https://remotive.com/remote-jobs/software-dev

# Optional: Gemini for coach message tone (rules always work without this)
# GEMINI_API_KEY=
